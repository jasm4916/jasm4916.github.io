---
// Two redrawn captures as reference channels on the instrument. The client script plays REF A,
// then REF B, then shows the verdict; the REF buttons switch by hand. Without JS both captures
// show one after the other with their callouts, followed by the verdict.
import SimScope from './SimScope.astro';
interface Props { a: string; b: string; aLabel: string; bLabel: string; verdict?: string; aFull: string; bFull: string; group: string }
const { a, b, aLabel, bLabel, verdict, aFull, bFull, group } = Astro.props;
const split = (s: string) => { const i = s.indexOf(':'); return i < 0 ? [s, ''] : [s.slice(0, i), s.slice(i + 1).trim()]; };
const [aName, aVal] = split(aLabel);
const [bName, bVal] = split(bLabel);
---
<div class="simcmp refcmp" data-refcmp data-sim>
  <div class="ref-imgs">
    <figure class="ref-img on" data-ref="a">
      <SimScope id={a} label={`Redrawn scope capture: ${aLabel}`} />
      <figcaption class="ref-cap">REF A · {aLabel}</figcaption>
    </figure>
    <figure class="ref-img" data-ref="b">
      <SimScope id={b} label={`Redrawn scope capture: ${bLabel}`} />
      <figcaption class="ref-cap">REF B · {bLabel}</figcaption>
    </figure>
  </div>
  <div class="sim-bar">
    <div class="ref-btns" role="group" aria-label="Reference channel">
      <button type="button" class="ref-btn on" data-ref="a" aria-pressed="true"><span class="sw"></span><span class="r">REF A</span> <b>{aName}</b>{aVal && <span class="val">{aVal}</span>}</button>
      <button type="button" class="ref-btn" data-ref="b" aria-pressed="false"><span class="sw"></span><span class="r">REF B</span> <b>{bName}</b>{bVal && <span class="val">{bVal}</span>}</button>
    </div>
    <span class="orig">
      <a href={aFull} data-lightbox={`${group}-orig`} data-caption={`Original capture: ${aLabel}`}>original A</a> ·
      <a href={bFull} data-lightbox={`${group}-orig`} data-caption={`Original capture: ${bLabel}`}>B</a>
    </span>
  </div>
  {verdict && <p class="verdict" aria-live="polite">{verdict}</p>}
</div>
