<dialog class="lightbox" id="lightbox" aria-label="Image viewer">
  <figure>
    <img alt="" />
    <figcaption></figcaption>
  </figure>
  <div class="lb-bar">
    <button type="button" data-lb="prev" aria-label="Previous image">←</button>
    <span class="lb-count" aria-live="polite"></span>
    <span style="display:flex;gap:8px">
      <button type="button" data-lb="next" aria-label="Next image">→</button>
      <button type="button" data-lb="close" aria-label="Close image viewer">✕</button>
    </span>
  </div>
</dialog>
