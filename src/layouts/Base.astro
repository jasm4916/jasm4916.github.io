---
import '@fontsource/chakra-petch/latin-500.css';
import '@fontsource/chakra-petch/latin-600.css';
import '@fontsource/chakra-petch/latin-700.css';
import '@fontsource/inter/latin-400.css';
import '@fontsource/inter/latin-500.css';
import '@fontsource/inter/latin-600.css';
import '@fontsource/inter/greek-400.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import '@fontsource/jetbrains-mono/greek-400.css';
import '@fontsource/jetbrains-mono/greek-600.css';
import '../styles/global.css';
import { SITE } from '../site.config';
// Preload the two faces the first screen paints with (the name and body text).
import chakra700 from '@fontsource/chakra-petch/files/chakra-petch-latin-700-normal.woff2?url';
import inter400 from '@fontsource/inter/files/inter-latin-400-normal.woff2?url';
import { withBase } from '../lib/content';

interface Props { ch?: number; channelCss?: string; title?: string; description?: string; path?: string }
const { ch, channelCss = '', title = SITE.title, description = SITE.description, path = '/' } = Astro.props;
const canonical = new URL(withBase(path), Astro.site).href;
const og = new URL(withBase('/og.png'), Astro.site).href;
---
<!doctype html>
<html lang="en" class="no-js" data-ch={ch}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="preload" href={chakra700} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={inter400} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#0b0c0e" />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="icon" href={withBase('/favicon.png')} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.remove('no-js');
        d.classList.add('js');
        var m = location.hash.match(/^#board-(\d+)/);
        if (m) d.setAttribute('data-ch', m[1]);
      })();
    </script>
    <style is:inline set:html={channelCss}></style>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <slot />
  </body>
</html>
